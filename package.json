{
  "name": "localtify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight native local music player built with Tauri, Rust, React, and TypeScript.",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && tauri build",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build:web && cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
